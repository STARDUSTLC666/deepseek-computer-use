{
  "name": "deepseek-computer-use",
  "version": "0.2.15",
  "description": "DeepSeek Harness Windows 桌面操作插件：窗口截图、界面控件树、鼠标键盘、会话授权与操作审计。欢迎提交 issues 和 PR。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": "./lib/update-client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/plugin-icon.webp"
  },
  "files": [
    "lib",
    "native/Json.cs",
    "native/Driver.cs",
    "native/Program.cs",
    "native/Overlay.cs",
    "native/audio/Audio.csproj",
    "native/audio/Program.cs",
    "native/wgcfw/Capture.csproj",
    "native/wgcfw/Program.cs",
    "skills",
    "assets/cover-whale-girl.png",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "README.en.md",
    "assets/plugin-icon.webp",
    "locale"
  ],
  "scripts": {
    "build": "node lib/build.mjs && node scripts/build-updates.mjs",
    "build:helper": "node lib/build.mjs",
    "test": "node scripts/build-updates.mjs && node --test test/contracts.test.mjs test/bridge.test.mjs",
    "test:contracts": "node --test test/contracts.test.mjs test/bridge.test.mjs",
    "test:harness": "node test/harness.mjs",
    "test:all": "npm test && npm run test:integration && node test/parity.mjs && node test/parity-js.mjs",
    "test:integration": "node test/integration.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml",
      "platforms": [
        "win32"
      ]
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.3"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "computer-use",
    "windows",
    "uia",
    "desktop-automation",
    "wgc",
    "accessibility",
    "deepseek",
    "ai-agent",
    "gui-agent",
    "桌面自动化",
    "电脑操作"
  ],
  "license": "MIT",
  "author": "STARDUSTLC666",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/STARDUSTLC666/deepseek-computer-use.git"
  },
  "homepage": "https://github.com/STARDUSTLC666/deepseek-computer-use#readme",
  "bugs": {
    "url": "https://github.com/STARDUSTLC666/deepseek-computer-use/issues"
  },
  "os": [
    "win32"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@stardustlc/dsh-updates": "0.2.2"
  },
  "packageManager": "pnpm@11.7.0",
  "icon": "./assets/plugin-icon.webp"
}
